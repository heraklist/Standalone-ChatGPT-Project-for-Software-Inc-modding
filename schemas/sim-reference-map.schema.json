{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIM Reference Map",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "source_id", "output_path", "package_path", "canonical_source_paths", "source_sha256", "transform_type", "output_sha256"],
        "properties": {
          "reference_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "output_path": {"type": "string", "minLength": 1},
          "package_path": {"type": "string", "pattern": "^references/.+"},
          "canonical_source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_sha256": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "transform_type": {"enum": ["COPY", "EXCERPT", "DERIVED_METADATA"]},
          "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
