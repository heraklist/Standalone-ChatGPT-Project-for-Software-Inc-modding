{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIM Session",
  "type": "object",
  "required": ["meta", "goal", "target", "baseline", "architecture", "workspace", "evidence", "decisions", "validation", "artifact", "risks", "history"],
  "properties": {
    "meta": {"type": "object", "required": ["session_id"], "properties": {"session_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "goal": {"type": "object", "required": ["summary"], "properties": {"summary": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "target": {"type": "object", "required": ["game_version"], "properties": {"game_version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "baseline": {"type": "object", "additionalProperties": false},
    "architecture": {"type": "object", "additionalProperties": false},
    "workspace": {"type": "object", "additionalProperties": false},
    "evidence": {"type": "object", "additionalProperties": false},
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "summary"], "properties": {"id": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "validation": {"type": "object", "additionalProperties": false},
    "artifact": {
      "type": "object",
      "required": ["state", "verification_level"],
      "properties": {
        "state": {"enum": ["ARTIFACT_UNBUILT", "CANDIDATE_ARTIFACT", "FINAL_ARTIFACT"]},
        "verification_level": {"enum": ["V0 DESIGN_READY", "V1 ARTIFACT_GENERATED", "V2 STATICALLY_REVIEWED", "V3 LOAD_OR_NATIVE_OPEN_VERIFIED", "V4 BEHAVIOR_VERIFIED", "V5 REGRESSION_VERIFIED"]}
      },
      "additionalProperties": false
    },
    "risks": {"type": "array", "items": {"type": "object", "required": ["class", "summary"], "properties": {"class": {"enum": ["R0", "R1", "R2", "R3"]}, "summary": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "history": {"type": "array", "items": {"type": "object", "required": ["event"], "properties": {"event": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
