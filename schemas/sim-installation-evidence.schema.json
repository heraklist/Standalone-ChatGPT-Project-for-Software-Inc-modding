{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evochia.local/schemas/sim-installation-evidence.schema.json",
  "title": "SIM Installation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "installation_evidence_id",
    "surface",
    "result",
    "candidate_tree_sha256",
    "semantic_aggregate_sha256",
    "source_commit",
    "projection_commit",
    "plugin_version",
    "exact_target_manifest_sha256",
    "transport",
    "observed_public_skill_count",
    "observed_public_skill_names",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "installation_evidence_id": {"type": "string", "minLength": 1},
    "surface": {"enum": ["ChatGPT", "Codex", "ChatGPT Project"]},
    "result": {"enum": ["PASS", "FAIL", "PLATFORM_LIMITATION"]},
    "candidate_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_aggregate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "projection_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "marketplace_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "plugin_version": {"type": "string", "minLength": 1},
    "exact_target_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transport": {"type": "string", "minLength": 1},
    "marketplace_name": {"type": "string", "minLength": 1},
    "plugin_locator": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_public_skill_count": {"type": "integer", "minimum": 0},
    "observed_public_skill_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
