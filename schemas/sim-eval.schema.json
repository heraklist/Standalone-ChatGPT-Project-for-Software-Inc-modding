{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIM Behavioral Evals",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "prompt", "required_outcomes", "forbidden_outcomes", "pass_rule"],
    "properties": {
      "id": {"type": "string", "pattern": "^S[0-9]{3,}$"},
      "title": {"type": "string", "minLength": 1},
      "category": {"type": "string", "minLength": 1},
      "prompt": {"type": "string", "minLength": 1},
      "required_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "forbidden_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "pass_rule": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}
